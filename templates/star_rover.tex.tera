\documentclass[11pt]{article}

% Native OpenType fonts with fontspec for LuaLaTeX
\usepackage{fontspec}
\setmainfont{Fira Sans}[
  UprightFont={* Regular},
  BoldFont={* SemiBold},
  ItalicFont={* Italic},
  BoldItalicFont={* SemiBold Italic}
]

\usepackage[a4paper,margin=1in]{geometry}

\usepackage{xcolor}
\definecolor{accent}{HTML}{141E61}

\usepackage{fontawesome5}

\newcommand{\linkicon}{
  \color{gray}{\footnotesize\raisebox{1pt}{\faIcon{external-link-alt}}}
}

\setcounter{secnumdepth}{0}

%====== LIST FORMATTING ======
\usepackage{enumitem}
\setlist[itemize]{nosep, left=0pt .. 1.5em}
\setlist[enumerate]{left=0pt..1.5em}
\setlist[description]{itemsep=0pt}

%====== TITLE FORMATTING ======
\usepackage{xhfill}
\usepackage{soul}
\newcommand{\midrule}[1]{
  \leavevmode
  \xrfill[.5ex]{1pt}[accent]~{% raw %}\so{#1}{% endraw %}~\xrfill[.5ex]{1pt}[accent]
}

\usepackage{titlesec}
\titlespacing{\section}{0pt}{*4}{*1}
\titleformat{\section}{\large\bfseries\uppercase}{}{}{\midrule}

\usepackage{tabularx}

%====== CUSTOM COMMANDS ======
\newcommand{\aux}[1]{
  $|$ \space {\normalfont\itshape #1}
}

{% raw %}
% Entry header (Education, Experience company, Projects): wraps left title, right-aligns date/location
\newcommand{\cventry}[2]{%
  \vspace{0.4em}\noindent
  \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X r@{}}
    {\large\bfseries\scshape #1} & {\normalfont\color{accent}\mbox{#2}}
  \end{tabularx}%
  \par\vspace{0.1em}
}

% Sub-entry header (Roles within a company): wraps role title, right-aligns role dates
\newcommand{\cvsubentry}[2]{%
  \vspace{0.3em}\noindent
  \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X r@{}}
    {\bfseries #1} & {\normalfont\color{accent}\mbox{#2}}
  \end{tabularx}%
  \par\vspace{0.1em}
}
{% endraw %}

\newcommand{\rside}[1]{
  \hfill {\normalfont\color{accent}\mbox{ #1 }}
}

%====== FOOTER ======
\usepackage{lastpage}
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}

\fancyfoot[C]{\small\color{gray} {{ contact.name | latex_escape }} -- Page \thepage\ of \pageref*{LastPage}}

{% if hide_page_numbers %}
\pagestyle{empty}
{% endif %}

\usepackage{multicol}
\usepackage[bookmarks=false,hidelinks]{hyperref}

%====== DOCUMENT STARTS HERE ======
\begin{document}

%====== BANNER ======
\begin{center}
  {
    \fontsize{36}{12}\selectfont
    \bfseries
    \color{accent}
    {{ contact.name | upper | latex_escape }}
  } \\ \medskip

  {% if contact.phone -%}
    \mbox{\href{tel:{{ contact.phone }}}{ { \color{gray}\faPhone }~{{ contact.phone | latex_escape }} }}\quad
  {% endif -%}
  {% if contact.email -%}
    \mbox{\href{mailto:{{ contact.email }}}{ { \color{gray}\faEnvelope }~{{ contact.email | latex_escape }} }}\quad
  {% endif -%}
  {% if contact.github -%}
    \mbox{\href{https://github.com/{{ contact.github }}}{ { \color{gray}\faGithub }~{{ contact.github | latex_escape }} }}\quad
  {% endif -%}
  {% if contact.linkedin -%}
    \mbox{\href{https://linkedin.com/in/{{ contact.linkedin }}}{ { \color{gray}\faLinkedin }~{{ contact.linkedin | latex_escape }} }}\quad
  {% endif -%}
  {% if contact.website -%}
    \mbox{\href{ {{ contact.website }} }{ { \color{gray}\faLink }~{{ contact.website | latex_escape }} }}\quad
  {% endif -%}
  {% if contact.location -%}
    \mbox{{ '{' }}{ \color{gray}\faMapMarker* }~{{ contact.location | latex_escape }}}
  {% endif -%}
\end{center}

{% if summary %}
\section{Summary}
{{ summary | latex_escape }}
{% endif %}

{% if education and education | length > 0 %}
\section{Education}
{% for edu in education %}
\cventry{ {{- edu.institution | latex_escape -}}{% if edu.degree %} \aux{ {{- edu.degree | latex_escape -}} }{% endif %}}{ {{- edu.dates | default(value='') | latex_escape -}} }
{% if edu.highlights and edu.highlights | length > 0 %}
\begin{itemize}
{% for h in edu.highlights %}
  \item {{ h | latex_escape }}
{% endfor %}
\end{itemize}
{% endif %}
{% endfor %}
{% endif %}

{% if experience and experience | length > 0 %}
\section{Experience}
{% for exp in experience %}
\cventry{ {{- exp.company | latex_escape -}} }{ {{- exp.location | default(value='') | latex_escape -}} }
{% for role in exp.roles %}
\cvsubentry{ {{- role.title | latex_escape -}} }{ {{- role.dates | default(value='') | latex_escape -}} }
{% if role.highlights and role.highlights | length > 0 %}
\begin{itemize}
{% for h in role.highlights %}
  \item {{ h | latex_escape }}
{% endfor %}
\end{itemize}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}

{% if projects and projects | length > 0 %}
\section{Projects}
{% for proj in projects %}
\cventry{ {{- proj.name | latex_escape -}}{% if proj.url %} \aux{\href{ {{- proj.url -}} }{Link \linkicon}}{% endif %}}{ {{- proj.dates | default(value='') | latex_escape -}} }
{% if proj.highlights and proj.highlights | length > 0 %}
\begin{itemize}
{% for h in proj.highlights %}
  \item {{ h | latex_escape }}
{% endfor %}
\end{itemize}
{% endif %}
{% endfor %}
{% endif %}

{% if skills and skills | length > 0 %}
\section{Skills}
\begin{description}
{% for skill in skills %}
  \item[{{ skill.category | latex_escape }}] {{ skill.items | join(sep=', ') | latex_escape }}
{% endfor %}
\end{description}
{% endif %}

{% if certifications and certifications | length > 0 %}
\section{Certifications}
\begin{enumerate}[label=\null, left=0pt..0pt, itemsep=0pt]
{% for cert in certifications %}
  \item {{ cert.name | latex_escape }}{% if cert.issuer %}, {{ cert.issuer | latex_escape }}{% endif %}{% if cert.date %} \rside{ {{- cert.date | latex_escape -}} }{% endif %}
{% endfor %}
\end{enumerate}
{% endif %}

{% if publications and publications | length > 0 %}
\section{Publications}
\begin{enumerate}
{% for pub in publications %}
  \item {{ pub.citation | latex_escape }}{% if pub.url %} \aux{\href{ {{- pub.url -}} }{[Online] \linkicon}}{% endif %}
{% endfor %}
\end{enumerate}
{% endif %}

{% if awards and awards | length > 0 %}
\section{Awards}
\begin{description}
{% for award in awards %}
  \item [{{ award.date | default(value='') | latex_escape }}] {{ award.title | latex_escape }}{% if award.summary %}, {{ award.summary | latex_escape }}{% endif %}
{% endfor %}
\end{description}
{% endif %}

\end{document}
